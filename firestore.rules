rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* -------- AUTH HELPERS -------- */

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      // Helper to fetch the current user document from the root collection
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDoc().data.role;
    }

    function userTenant() {
      return userDoc().data.tenantId;
    }

    // UPDATED: Fixed role check to use 'super-admin' (matching your app code)
    function isSuperAdmin() {
      return isAuthenticated() && (userRole() == "super-admin" || userRole() == "super_admin");
    }

    function isAdmin() {
      return isAuthenticated() && userRole() == "admin";
    }

    function isTrainer() {
      return isAuthenticated() && userRole() == "trainer";
    }

    function isUser() {
      return isAuthenticated() && userRole() == "user";
    }

    function belongsToTenant(tenantId) {
      return userTenant() == tenantId;
    }

    /* -------- COLLECTION GROUP MATCHES (CRITICAL FOR UI) -------- */
    
    match /{path=**}/admins/{adminId} {
      allow read: if isSuperAdmin();
    }

    match /{path=**}/trainers/{trainerId} {
      allow read: if isSuperAdmin();
    }

    match /{path=**}/users/{userId} {
      // Matches both root users and tenant sub-collection users
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      // CRITICAL: Allows Super Admin to perform the Batch Update on sub-collections
      allow write: if isSuperAdmin();
    }

    /* -------- USERS (ROOT) -------- */

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isSuperAdmin();
      allow create: if request.auth.uid == userId || isSuperAdmin();
      allow update: if request.auth.uid == userId || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /* -------- TENANTS (HIERARCHICAL) -------- */

    match /tenants/{tenantId} {
      allow create: if isSuperAdmin();
      allow read: if isAuthenticated() && (isSuperAdmin() || belongsToTenant(tenantId));
      allow update, delete: if isSuperAdmin();

      // Explicit match for the users sub-collection inside a tenant
      match /users/{userId} {
        allow read: if isAuthenticated() && (isSuperAdmin() || belongsToTenant(tenantId));
        allow write: if isSuperAdmin();
      }

      /* -------- ADMINS (Legacy or specific role) -------- */
      match /admins/{adminId} {
        allow read: if isAuthenticated() && (isSuperAdmin() || belongsToTenant(tenantId));
        allow create, update, delete: if isSuperAdmin();
      }

      /* -------- TRAINERS -------- */
      match /trainers/{trainerId} {
        allow read: if isAuthenticated() && (isSuperAdmin() || belongsToTenant(tenantId));
        allow create, update, delete: if (isAdmin() || isSuperAdmin()) && belongsToTenant(tenantId);
      }

      /* -------- EVENTS -------- */
      match /events/{eventId} {
        allow read: if true;
        allow create: if (isAdmin() || isTrainer() || isSuperAdmin()) && belongsToTenant(tenantId);
        allow update, delete: if (isAdmin() || isSuperAdmin()) && belongsToTenant(tenantId);

        /* -------- SLOTS -------- */
        match /slots/{slotId} {
          allow read: if true;
          allow create, update, delete: if (isAdmin() || isTrainer() || isSuperAdmin()) && belongsToTenant(tenantId);
        }
      }

      /* -------- BOOKINGS -------- */
      match /bookings/{bookingId} {
        allow create: if isUser() && belongsToTenant(tenantId);
        allow read: if request.auth.uid == resource.data.userId ||
          ((isAdmin() || isTrainer() || isSuperAdmin()) && belongsToTenant(tenantId));
        allow update, delete: if isAdmin() || isSuperAdmin();
      }
    }

    /* -------- PUBLIC EVENTS -------- */

    match /publicEvents/{eventId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }
  }
}