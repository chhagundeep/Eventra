rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* -------- AUTH HELPERS -------- */

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      let role = getUserData().role;
      return isAuthenticated() && (role == "super-admin" || role == "super_admin");
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == "admin";
    }

    function isTrainer() {
      return isAuthenticated() && getUserData().role == "trainer";
    }

    function belongsToTenant(tenantId) {
      return isAuthenticated() && getUserData().tenantId == tenantId;
    }

    /* -------- COLLECTION GROUP MATCHES (CRITICAL FOR UI) -------- */
    
    match /{path=**}/admins/{adminId} {
      allow read: if isSuperAdmin();
    }

    match /{path=**}/trainers/{trainerId} {
      allow read: if isSuperAdmin();
      allow read: if isAuthenticated();
    }

    match /{path=**}/users/{userId} {
      // Matches both root users and tenant sub-collection users
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      // CRITICAL: Allows Super Admin to perform the Batch Update on sub-collections
      allow write: if isSuperAdmin();
    }

    /* -------- USERS (ROOT) -------- */

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isSuperAdmin() || isAdmin();
      allow create: if request.auth.uid == userId || isSuperAdmin();
      // ADDED: isAdmin() so they can sync name/email in the global collection
      allow update: if request.auth.uid == userId || isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin();
    }
    /* -------- CATEGORIES (ROOT) -------- */
    
    match /categories/{categoryId} {
      // Allow anyone to read categories (for the interest selection screen)
      allow read: if true; 
      
      // Only Super Admins can seed or modify global categories
      allow write: if isSuperAdmin();
    }
    

    /* -------- TENANTS (HIERARCHICAL) -------- */

    match /tenants/{tenantId} {
      allow create: if isSuperAdmin();
      allow read: if isAuthenticated() && (isSuperAdmin() || belongsToTenant(tenantId));
      allow update, delete: if isSuperAdmin();

      // Explicit match for the users sub-collection inside a tenant
      match /users/{userId} {
        allow read: if isAuthenticated() && (isSuperAdmin() || belongsToTenant(tenantId));
        allow write: if isSuperAdmin();
      }

      /* -------- ADMINS (Legacy or specific role) -------- */
      match /admins/{adminId} {
        allow read: if isAuthenticated() && (isSuperAdmin() || belongsToTenant(tenantId));
        allow create, update, delete: if isSuperAdmin();
      }

      /* -------- TRAINERS -------- */
      match /trainers/{trainerId} {
        allow read: if isAuthenticated() && (isSuperAdmin() || belongsToTenant(tenantId));
        
        // This is correct: allows Super Admin OR a Tenant Admin to update
        allow create, update, delete: if isSuperAdmin() || (isAdmin() && belongsToTenant(tenantId));
      }

      /* -------- EVENTS -------- */
      match /events/{eventId} {
        allow read: if true;

        // Allowing Super Admin globally OR (Admin/Trainer/SuperAdmin matching the tenant)
        allow create: if isSuperAdmin() || 
          ((isAdmin() || isTrainer()) && belongsToTenant(tenantId));

        // Allowing Super Admin globally OR (Admin matching the tenant)
        allow update, delete: if isSuperAdmin() || 
          (isAdmin() && belongsToTenant(tenantId));

        /* -------- SLOTS -------- */
        match /slots/{slotId} {
          allow read: if true;
          allow create, update, delete: if isSuperAdmin() || 
            ((isAdmin() || isTrainer()) && belongsToTenant(tenantId));
        }
      }

      /* -------- BOOKINGS -------- */
      match /bookings/{bookingId} {
        // This checks if the user is authenticated, since we removed the specific isUser helper
        allow create: if isAuthenticated() && belongsToTenant(tenantId);
        allow read: if request.auth.uid == resource.data.userId ||
          ((isAdmin() || isTrainer() || isSuperAdmin()) && belongsToTenant(tenantId));
        allow update, delete: if isAdmin() || isSuperAdmin();
      }
    }

    /* -------- PUBLIC EVENTS -------- */

    match /publicEvents/{eventId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }
  }
}